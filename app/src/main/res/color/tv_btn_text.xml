<?xml version="1.0" encoding="utf-8"?>
<!-- Player buttons: focused = brand-green pill, so text flips to black;
     default = surface grey pill with primary text. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/on_accent" android:state_focused="true" />
    <item android:color="@color/on_accent" android:state_pressed="true" />
    <item android:color="@color/text_primary" />
</selector>
