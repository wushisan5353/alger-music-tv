<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ph_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingLeft="@dimen/ph_page_padding"
    android:paddingTop="18dp"
    android:paddingRight="@dimen/ph_page_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/row_settings"
        android:textColor="@color/ph_text"
        android:textSize="@dimen/ph_text_page_title"
        android:textStyle="bold" />

    <!-- Alger settings pattern: one bordered/surface card per item,
         title + one-line description, control below. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/ph_input_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/custom_api"
            android:textColor="@color/ph_text"
            android:textSize="@dimen/ph_text_song" />

        <TextView
            android:id="@+id/settings_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ph_accent"
            android:textSize="@dimen/ph_text_artist" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/custom_api_hint"
            android:textColor="@color/ph_text_54"
            android:textSize="@dimen/ph_text_artist" />

        <EditText
            android:id="@+id/settings_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/ph_search_bg"
            android:hint="http://192.168.1.10:3000"
            android:inputType="textUri"
            android:paddingLeft="14dp"
            android:paddingTop="11dp"
            android:paddingRight="14dp"
            android:paddingBottom="11dp"
            android:singleLine="true"
            android:textColor="@color/ph_text"
            android:textColorHint="@color/ph_text_38"
            android:textSize="@dimen/ph_text_artist" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ph_btn_primary_bg"
                android:minHeight="40dp"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:text="@string/save"
                android:textColor="@color/ph_on_accent"
                android:textSize="@dimen/ph_text_artist"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_clear_api"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/ph_btn_ghost_bg"
                android:minHeight="40dp"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:text="@string/clear"
                android:textColor="@color/ph_text"
                android:textSize="@dimen/ph_text_artist" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
