<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ph_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/ph_page_padding"
        android:paddingTop="16dp"
        android:paddingRight="@dimen/ph_page_padding">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ph_search_bg"
            android:hint="@string/phone_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textColor="@color/ph_text"
            android:textColorHint="@color/ph_text_38"
            android:textSize="@dimen/ph_text_song" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/ph_btn_primary_bg"
            android:minHeight="44dp"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="@string/phone_search_action"
            android:textColor="@color/ph_on_accent"
            android:textSize="@dimen/ph_text_artist"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ph_page_padding"
        android:layout_marginTop="18dp"
        android:text="@string/row_hot_search"
        android:textColor="@color/ph_text_54"
        android:textSize="@dimen/ph_text_artist" />

    <LinearLayout
        android:id="@+id/hot_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ph_page_padding"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/ph_page_padding"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/search_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/ph_text_54"
        android:textSize="@dimen/ph_text_artist"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/view_mini_player" />
</LinearLayout>
