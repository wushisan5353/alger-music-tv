<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ph_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/ph_page_padding"
        android:paddingTop="18dp"
        android:paddingRight="@dimen/ph_page_padding"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/pl_cover"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/ph_cover_box"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pl_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ph_text"
                android:textSize="@dimen/ph_text_page_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pl_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ph_text_54"
                android:textSize="@dimen/ph_text_artist" />

            <Button
                android:id="@+id/btn_play_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/ph_btn_primary_bg"
                android:minHeight="40dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="@string/play_all"
                android:textColor="@color/ph_on_accent"
                android:textSize="@dimen/ph_text_artist"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/pl_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/loading"
        android:textColor="@color/ph_text_54"
        android:textSize="@dimen/ph_text_artist"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/view_mini_player" />
</LinearLayout>
