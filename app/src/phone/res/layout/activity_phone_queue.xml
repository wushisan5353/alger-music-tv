<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ph_bg"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/ph_page_padding"
        android:paddingTop="18dp"
        android:paddingRight="@dimen/ph_page_padding"
        android:paddingBottom="8dp"
        android:text="@string/phone_queue"
        android:textColor="@color/ph_text"
        android:textSize="@dimen/ph_text_page_title"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_queue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/view_mini_player" />
</LinearLayout>
