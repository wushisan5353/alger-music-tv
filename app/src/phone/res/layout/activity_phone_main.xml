<?xml version="1.0" encoding="utf-8"?>
<!-- Phone home, Alger mobile structure: capsule search on top, then
     section title + horizontal cover cards, then the full chart list.
     Pure black page; grey tiers separate sections, no borders. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ph_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/ph_page_padding"
        android:paddingTop="16dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/ph_text"
            android:textSize="@dimen/ph_text_page_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_settings"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/row_settings"
            android:textColor="@color/ph_text_54"
            android:textSize="@dimen/ph_text_artist" />
    </LinearLayout>

    <TextView
        android:id="@+id/search_entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ph_page_padding"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/ph_page_padding"
        android:background="@drawable/ph_search_bg"
        android:drawableLeft="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:text="@string/phone_search_hint"
        android:textColor="@color/ph_text_38"
        android:textSize="@dimen/ph_text_song" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ph_page_padding"
                android:layout_marginTop="22dp"
                android:text="@string/row_toplist"
                android:textColor="@color/ph_text"
                android:textSize="@dimen/ph_text_section"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_toplist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingLeft="@dimen/ph_page_padding"
                android:paddingRight="@dimen/ph_page_padding" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ph_page_padding"
                android:layout_marginTop="24dp"
                android:text="@string/row_recommend"
                android:textColor="@color/ph_text"
                android:textSize="@dimen/ph_text_section"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recommend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingLeft="@dimen/ph_page_padding"
                android:paddingRight="@dimen/ph_page_padding" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ph_page_padding"
                android:layout_marginTop="24dp"
                android:text="@string/phone_all_charts"
                android:textColor="@color/ph_text"
                android:textSize="@dimen/ph_text_section"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/toplist_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_mini_player" />
</LinearLayout>
