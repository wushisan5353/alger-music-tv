<?xml version="1.0" encoding="utf-8"?>
<!-- Chart list row: rank + rounded cover + name/meta two lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/ph_page_padding"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/ph_page_padding"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/row_rank"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/ph_text_54"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/row_cover"
        android:layout_width="@dimen/ph_toplist_cover"
        android:layout_height="@dimen/ph_toplist_cover"
        android:layout_marginLeft="6dp"
        android:background="@drawable/ph_cover_box"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ph_text"
            android:textSize="@dimen/ph_text_song" />

        <TextView
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ph_text_54"
            android:textSize="@dimen/ph_text_aux" />
    </LinearLayout>
</LinearLayout>
