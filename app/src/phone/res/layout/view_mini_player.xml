<?xml version="1.0" encoding="utf-8"?>
<!-- Mini player: surface sheet with a 3dp green progress hairline on its
     top edge (Alger PlayBar's signature), rounded cover, name/artist,
     play + next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ph_mini_bg"
    android:orientation="vertical"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/mini_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="@color/ph_surface3"
        android:progressTint="@color/ph_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="6dp">

        <ImageView
            android:id="@+id/mini_cover"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/ph_cover_box"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ph_text"
                android:textSize="@dimen/ph_text_song" />

            <TextView
                android:id="@+id/mini_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ph_text_54"
                android:textSize="@dimen/ph_text_aux" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_mini_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/ph_text" />

        <ImageButton
            android:id="@+id/btn_mini_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:src="@android:drawable/ic_media_next"
            android:tint="@color/ph_text" />
    </LinearLayout>
</LinearLayout>
